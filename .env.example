# ============================================================
# Konfigurasi Lingkungan SunnyRest (Lokal Hardhat & Ethereum Sepolia)
# Salin menjadi .env dan sesuaikan sebelum menjalankan layanan.
# ============================================================

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
# Gunakan 31337 untuk Hardhat lokal, atau 11155111 untuk Ethereum Sepolia
VITE_CHAIN_ID=31337
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS_LOCAL=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Isi setelah kontrak dideploy ke Sepolia:
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CONTRACT_ADDRESS_SEPOLIA=
# Gateway publik untuk menampilkan & memverifikasi media/metadata IPFS (browser-safe)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# --- Backend (FastAPI, IPFS Pinning Proxy & Verifikasi On-Chain) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pilih salah satu layanan IPFS server-side (PINATA_JWT diprioritaskan jika keduanya terisi):
PINATA_JWT=
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
# Sesuaikan RPC_URL & CONTRACT_ADDRESS ke Sepolia jika mode produksi aktif:
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VERIFY_ONCHAIN_PAYMENT=true

# --- Smart Contract / Hardhat Deployer ---
LOCALHOST_RPC_URL=http://127.0.0.1:8545
SEPOLIA_RPC_URL=
PRIVATE_KEY=
ETHERSCAN_API_KEY=
