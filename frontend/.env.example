# Frontend Vite Environment (Salin ke frontend/.env atau gunakan .env di root repo)
VITE_API_URL=http://localhost:8000

# Target Jaringan Default: 31337 (Hardhat Localhost) atau 11155111 (Ethereum Sepolia)
VITE_CHAIN_ID=31337

# Konfigurasi Hardhat Localhost
VITE_LOCAL_RPC_URL=http://127.0.0.1:8545
VITE_CONTRACT_ADDRESS_LOCAL=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Konfigurasi Ethereum Sepolia Testnet
VITE_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
VITE_CONTRACT_ADDRESS_SEPOLIA=

# Gateway Pembaca Konten IPFS (tanpa JWT rahasia)
VITE_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
