# Backend FastAPI Environment (Salin ke backend/.env atau gunakan .env di root repo)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Pinning IPFS Server-Side (rahasia PINATA_JWT tetap di backend, tidak dikirim ke browser)
PINATA_JWT=
IPFS_API_URL=http://127.0.0.1:5001
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/

# Verifikasi Pembayaran On-Chain (/enhance -> getPermintaan)
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VERIFY_ONCHAIN_PAYMENT=true
